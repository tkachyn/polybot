{
  "name": "browser-agent-arena-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "node --import tsx src/server.ts",
    "smoke:steel": "node --import tsx scripts/steel-smoke.ts",
    "check": "npm test && npm run build",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "fastify": "^5.12.4",
    "playwright": "^1.63.0",
    "steel-sdk": "^0.18.0"
  }
}
