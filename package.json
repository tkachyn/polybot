{
  "name": "browser-agent-arena-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "node --import tsx src/server.ts",
    "dev:sim": "RACE_MODE=simulated node --import tsx src/server.ts",
    "dev:course": "node --import tsx src/course-server.ts",
    "dev:all": "node --import tsx src/dev.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web test",
    "build:all": "npm run build && npm run web:build",
    "demo": "npm run web:build && RACE_MODE=simulated WEB_DIST=web/dist node --import tsx src/server.ts",
    "smoke:steel": "node --import tsx scripts/steel-smoke.ts",
    "race:shop": "node --import tsx scripts/create-shop-race.ts",
    "check": "npm test && npm run build",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "openai": "^7.15.0",
    "playwright": "^1.63.0",
    "steel-sdk": "^0.18.0"
  }
}
