# Copy to .env and load it before starting (e.g. `set -a; . ./.env; set +a`).
# Commented lines show the default used when the variable is unset.

# --- Server -----------------------------------------------------------------
# RACE_MODE=live                 # live | simulated
# PORT=3001
# HOST=127.0.0.1
# STARTING_BALANCE=1000          # credits granted to each new user
# SHOW_SABOTAGE_UPFRONT=true     # true|false|1|0|yes|no|on|off
# FIGHT_NUMBER_START=1           # simulated mode defaults to 401
# WEB_DIST=web/dist              # built SPA, served when the directory exists
# RACE_EVENT_FILE=data/race-events.jsonl   # live mode event log

# --- Simulated mode (RACE_MODE=simulated, no keys needed) --------------------
# SIM_SEED=sabotage-markets
# SIM_TIME_SCALE=1               # >1 speeds fights up (2 = twice as fast)

# --- Live mode: Steel browser sessions and the course -----------------------
STEEL_API_KEY=
STEEL_SMOKE_URL=https://example.com
COURSE_BASE_URL=http://localhost:4000
COURSE_VERIFIER_TOKEN=

# --- Live mode: models ------------------------------------------------------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
MASTER_LLM_MODEL=                # master (sabotage) policy model, Anthropic
COMPETITOR_LLM_MODEL=            # fallback model for Anthropic racers

# Per-racer overrides, n = 1..4 (racer-1 .. racer-4). They win over the
# roster sent with POST /races. Provider: openai | anthropic | google | xai.
# RACER_1_PROVIDER=openai
# RACER_1_MODEL=
# RACER_1_NAME=
# RACER_1_KEY=gpt
# RACER_2_PROVIDER=anthropic
# RACER_2_MODEL=
# RACER_2_KEY=claude
# RACER_3_PROVIDER=google
# RACER_3_MODEL=
# RACER_3_KEY=gemini
# RACER_4_PROVIDER=xai
# RACER_4_MODEL=
# RACER_4_KEY=grok

# --- Web dev server (read by web/vite.config.ts) ----------------------------
# VITE_API_TARGET=http://127.0.0.1:3001
# VITE_DEFAULT_LAYOUT=grid       # grid | lanes
