# live (Steel + OpenRouter) or simulated (no keys needed)
RACE_MODE=live
PORT=3001
HOST=127.0.0.1
STARTING_BALANCE=1000
SHOW_SABOTAGE_UPFRONT=true
# Defaults to 1 in live mode and 401 in simulated mode.
FIGHT_NUMBER_START=
WEB_DIST=web/dist
SIM_SEED=sabotage-markets
SIM_TIME_SCALE=1

# Comma-separated; the next key is used once the current one runs out of credits.
STEEL_API_KEYS=
# Single-key fallback (also accepted alongside STEEL_API_KEYS).
STEEL_API_KEY=
STEEL_SMOKE_URL=https://example.com
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=http://localhost:3001
OPENROUTER_APP_NAME=Browser Agent Arena
MASTER_LLM_MODEL=openai/gpt-5.6-luna
# Exactly four OpenRouter model ids, one per racer in order.
COMPETITOR_LLM_MODELS=openai/gpt-5.6-luna,anthropic/claude-haiku-4.5,google/gemma-3-27b-it,deepseek/deepseek-v4.1-flash
COMPETITOR_MAX_ACTIONS=20
RACE_LLM_BUDGET_USD=0.25
COURSE_BASE_URL=http://localhost:4000
COURSE_VERIFIER_TOKEN=
COURSE_PORT=4000
COURSE_HOST=127.0.0.1
RACE_EVENT_FILE=data/race-events.jsonl
