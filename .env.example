# Copy to .env. src/server.ts, src/dev.ts and src/course-server.ts load it
# automatically (dotenv). Commented lines show the default used when unset.

# --- Server -----------------------------------------------------------------
# RACE_MODE=live                 # live (Steel + OpenRouter) | simulated (no keys needed)
# PORT=3001
# HOST=127.0.0.1
# STARTING_BALANCE=1000          # credits granted to each new user
# DEMO_MODE=false                # locks equal bankrolls and enables QR judge onboarding
# SHOW_SABOTAGE_UPFRONT=true     # true|false|1|0|yes|no|on|off
# FIGHT_NUMBER_START=1           # simulated mode defaults to 401
# WEB_DIST=web/dist              # built SPA, served when the directory exists
# RACE_EVENT_FILE=data/race-events.jsonl   # live mode event log
# EVALUATION_FILE=data/evaluations.jsonl   # final fight evaluations
# DATASET_DIR=data/dataset                  # fight traces and keyframes
# REPLAY_DIR=data/replays                   # copied HLS playlists and media

# --- Simulated mode (RACE_MODE=simulated) -----------------------------------
# SIM_SEED=sabotage-markets
# SIM_TIME_SCALE=1               # >1 speeds fights up (2 = twice as fast)

# --- Live mode: Steel browser sessions --------------------------------------
# Comma-separated; the next key is used once the current one runs out of credits.
STEEL_API_KEYS=
# Single-key fallback (also accepted alongside STEEL_API_KEYS).
STEEL_API_KEY=
STEEL_SMOKE_URL=https://example.com

# --- Live mode: course ------------------------------------------------------
COURSE_BASE_URL=http://localhost:4000
COURSE_VERIFIER_TOKEN=
# COURSE_PORT=4000
# COURSE_HOST=127.0.0.1

# --- Live mode: models (OpenRouter) -----------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_APP_URL=http://localhost:3001
# OPENROUTER_APP_NAME=Browser Agent Arena
MASTER_LLM_MODEL=openai/gpt-5.6-luna
# Exactly four OpenRouter model ids, one per racer in order (racer-1..racer-4).
# Without an operator roster, each racer is labelled after its model.
COMPETITOR_LLM_MODELS=openai/gpt-5.6-luna,qwen/qwen3.8-27b,google/gemma-3-27b-it,anthropic/claude-haiku-4.5
# Shared per-model pacing. Each configured competitor model receives its own
# sliding window, so one provider cannot exhaust another model's capacity.
OPENROUTER_MODEL_MAX_CALLS_PER_MINUTE=20
OPENROUTER_MODEL_RATE_WINDOW_MS=60000
# Larger tool-call output leaves reasoning models enough room to reach the tool.
COMPETITOR_LLM_MAX_OUTPUT_TOKENS=512
# RACE_LLM_BUDGET_USD=0.25       # shared per-race LLM spend cap

# --- Live mode: market crowd ------------------------------------------------
# Automated traders that keep a live market moving, so the chart is not a flat
# line between checkpoints. They read the race late and imperfectly on purpose.
# MARKET_CROWD=true
# MARKET_CROWD_SIZE=14
# MARKET_CROWD_SEED=            # set for a reproducible crowd

# --- Web dev server (read by web/vite.config.ts) ----------------------------
# VITE_API_TARGET=http://127.0.0.1:3001
# VITE_DEFAULT_LAYOUT=grid       # grid | lanes
